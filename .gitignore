# Build folders
bin/
obj/

# User files
*.user
*.suo

# VS Code
.vscode/

# Development secrets - never commit
appsettings.Development.json
firebase-service-account.json
*wallet*
*.p12
*.pem
*.key

# Logs and temp build output
*.log
build-output.txt
build-output-utf8.txt
run-output.txt

# IDE cache
*.lscache

# Uploaded files - keep folder structure, ignore content
wwwroot/uploads/**
!wwwroot/uploads/avatars/
!wwwroot/uploads/banners/
!wwwroot/uploads/avatars/.gitkeep
!wwwroot/uploads/banners/.gitkeep
